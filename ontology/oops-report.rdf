  </rdf:Description>
  <rdf:Description rdf:about="http://oops.linkeddata.es/data/87f2df9e-e7e2-469a-833a-f4764cb2529f">
    <oops:hasAffectedElement rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://watchline.example/onto/hasDeed</oops:hasAffectedElement>
