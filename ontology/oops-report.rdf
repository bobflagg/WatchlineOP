  <rdf:Description rdf:about="http://oops.linkeddata.es/data/acecf35f-c345-4d15-bda0-66608d18208f">
    <oops:hasAffectedElement rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://watchline.example/onto/hasBuilding</oops:hasAffectedElement>
    <oops:hasAffectedElement rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://watchline.example/onto/hasOwnerContact</oops:hasAffectedElement>
