@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix vocab: <https://watchline.example/vocab/> .
@prefix onto:  <https://watchline.example/onto/> .
@prefix id:    <https://watchline.example/id/> .

# Must be inconsistent: a not-found resolution names a tax lot.
# Enforces "the agent does not guess a nearby lot".
id:neg-lot2 a onto:TaxLot .
id:neg-notfound a onto:AddressResolution ;
    onto:hasOutcome vocab:not-found ;
    onto:resolvedToTaxLot id:neg-lot2 .
