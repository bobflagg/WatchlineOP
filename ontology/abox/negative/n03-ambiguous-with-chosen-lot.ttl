@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix vocab: <https://watchline.example/vocab/> .
@prefix onto:  <https://watchline.example/onto/> .
@prefix id:    <https://watchline.example/id/> .

# Must be inconsistent: an ambiguous resolution names a chosen tax lot.
# Enforces "ambiguous matches return candidates and never silently select one".
id:neg-lot a onto:TaxLot .
id:neg-ambiguous a onto:AddressResolution ;
    onto:hasOutcome vocab:ambiguous ;
    onto:resolvedToTaxLot id:neg-lot .
