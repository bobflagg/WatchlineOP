# Q2 example data. Values come from the verified fixtures in tests/q2_*/fixtures.yaml
# (frozen snapshot: HPD registrations and contacts, 2026-05-29). Person names are not repeated:
# an individual or joint owner is given its type only. Values a fixture does not hold are omitted.

# Anchor A: one building, one registration, one corporate owner.
id:building-3014788 a onto:Building ; onto:bin "3014788" ; onto:hasRegistration id:reg-316103 .
id:reg-316103 a onto:Registration ; onto:registrationId 316103 ;
    onto:lastRegistered "2025-09-30"^^xsd:date ; onto:registrationEnd "2026-09-01"^^xsd:date ;
    onto:hasContact id:owner-316103-a .
id:owner-316103-a a onto:Contact ; onto:contactType "CorporateOwner" ; onto:corporationName "5413 PLAZA LLC" .

