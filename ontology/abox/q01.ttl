@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix vocab: <https://watchline.example/vocab/> .
@prefix onto:  <https://watchline.example/onto/> .
@prefix id:    <https://watchline.example/id/> .

# Q1 example data (anchors D and A), PROVISIONAL until verified against the frozen snapshot
# (specs/questions/q01.md, "Local snapshot check", queried 2026-11-10). No individuals' names.
# Geosupport codes and returned addresses are omitted: no cached response exists yet (profiles/geosupport.yaml).
# Two synthetic cases at the end (ambiguous, inferred) use placeholder values, not real records.

# --- Snapshots and records ---

id:snapshot-pluto-26v1 a onto:SourceSnapshot ;
    onto:snapshotId "pluto-26v1" .      # PLUTO has no record date: snapshotDate stays absent.

id:snapshot-hpd-registrations-2026-05-29 a onto:SourceSnapshot ;
    onto:snapshotId "hpd-registrations-2026-05-29" ;
    onto:snapshotDate "2026-05-29"^^xsd:date .

id:record-pluto-3008210012 a onto:SourceRecord ;
    onto:sourceKey "pluto" ;
    onto:sourceRecordLocator "public.pluto_latest:bbl=3008210012" ;
    onto:sourceCategory "public_record" ;
    onto:inSnapshot id:snapshot-pluto-26v1 .

id:record-pluto-3008260002 a onto:SourceRecord ;
    onto:sourceKey "pluto" ;
    onto:sourceRecordLocator "public.pluto_latest:bbl=3008260002" ;
    onto:sourceCategory "public_record" ;
    onto:inSnapshot id:snapshot-pluto-26v1 .

# --- Anchor D: multi-building lot, 224 54 Street ---

id:address-224-54-street a onto:StreetAddress ;
    onto:addressText "224 54 Street" .

id:address-pluto-224-54-street a onto:StreetAddress ;
    onto:addressText "224 54 STREET" .

id:taxlot-3008210012 a onto:TaxLot ;
    onto:hasBbl "3008210012" ;
    onto:hasRecordedAddress id:address-pluto-224-54-street ;
    onto:reportedYearBuilt 1911 ;
    onto:reportedBuildingClass "C1" ;
    onto:reportedResidentialUnits 18 ;
    onto:reportedAssessedValue 814500 ;
    onto:hasSourceRecord id:record-pluto-3008210012 .

id:building-3324448 a onto:Building ; onto:hasBin "3324448" .
id:building-3324450 a onto:Building ; onto:hasBin "3324450" .
id:building-3324451 a onto:Building ; onto:hasBin "3324451" .

id:hpd-registration-bin-3324448 a onto:HpdRegistration ;
    onto:registeredOnTaxLot id:taxlot-3008210012 ;
    onto:registersBuilding id:building-3324448 ;
    onto:hasSourceRecord id:record-hpd-bin-3324448 .
id:hpd-registration-bin-3324450 a onto:HpdRegistration ;
    onto:registeredOnTaxLot id:taxlot-3008210012 ;
    onto:registersBuilding id:building-3324450 ;
    onto:hasSourceRecord id:record-hpd-bin-3324450 .
id:hpd-registration-bin-3324451 a onto:HpdRegistration ;
    onto:registeredOnTaxLot id:taxlot-3008210012 ;
    onto:registersBuilding id:building-3324451 ;
    onto:hasSourceRecord id:record-hpd-bin-3324451 .

id:record-hpd-bin-3324448 a onto:SourceRecord ;
    onto:sourceKey "hpd_registrations" ;
    onto:sourceRecordLocator "public.hpd_registrations:bin=3324448" ;
    onto:sourceCategory "public_record" ;
    onto:inSnapshot id:snapshot-hpd-registrations-2026-05-29 .
id:record-hpd-bin-3324450 a onto:SourceRecord ;
    onto:sourceKey "hpd_registrations" ;
    onto:sourceRecordLocator "public.hpd_registrations:bin=3324450" ;
    onto:sourceCategory "public_record" ;
    onto:inSnapshot id:snapshot-hpd-registrations-2026-05-29 .
id:record-hpd-bin-3324451 a onto:SourceRecord ;
    onto:sourceKey "hpd_registrations" ;
    onto:sourceRecordLocator "public.hpd_registrations:bin=3324451" ;
    onto:sourceCategory "public_record" ;
    onto:inSnapshot id:snapshot-hpd-registrations-2026-05-29 .

# Outcome per q01.md "Stage 1 pilot". The addressed building (224 54 Street = BIN 3324451) is
# provisional: the profile field addressed_building is pending until name normalization is settled.
id:resolution-d a onto:AddressResolution ;
    onto:hasInputAddress id:address-224-54-street ;
    onto:hasOutcome vocab:matched-by-variant ;
    onto:resolvedToTaxLot id:taxlot-3008210012 ;
    onto:hasAddressedBuilding id:building-3324451 ;
    onto:assertionType "type_i" .

id:count-d-parcel a onto:ParcelCount ;
    onto:countValue 1 ; onto:countingUnit "tax lot" ;
    onto:countedForTaxLot id:taxlot-3008210012 ;
    onto:assertionType "type_i" .
id:count-d-building-hpd a onto:BuildingCount ;
    onto:countValue 3 ; onto:countingUnit "building" ;
    onto:countedForTaxLot id:taxlot-3008210012 ;
    onto:countedFromRecord id:record-hpd-bin-3324448, id:record-hpd-bin-3324450, id:record-hpd-bin-3324451 ;
    onto:assertionType "type_i" .
id:count-d-building-pluto a onto:BuildingCount ;
    onto:countValue 3 ; onto:countingUnit "building" ;
    onto:countedForTaxLot id:taxlot-3008210012 ;
    onto:countedFromRecord id:record-pluto-3008210012 ;
    onto:assertionType "type_i" .
id:count-d-units a onto:UnitCount ;
    onto:countValue 18 ; onto:countingUnit "residential unit" ;
    onto:countedForTaxLot id:taxlot-3008210012 ;
    onto:countedFromRecord id:record-pluto-3008210012 ;
    onto:assertionType "type_i" .

