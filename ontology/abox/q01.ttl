# --- Synthetic cases (placeholder values, not records) ---

# Ambiguous: candidates are returned and no lot is chosen.
id:resolution-synthetic-ambiguous a onto:AddressResolution ;
    rdfs:comment "Synthetic placeholder: ambiguous input, two candidates, no lot chosen."@en ;
    onto:hasInputAddress id:address-synthetic-ambiguous ;
    onto:hasOutcome vocab:ambiguous ;
    onto:hasAddressCandidate id:candidate-synthetic-1, id:candidate-synthetic-2 .
id:address-synthetic-ambiguous a onto:StreetAddress ; onto:addressText "1 Example St" .
id:candidate-synthetic-1 a onto:AddressCandidate ; onto:candidateText "EXAMPLE STREET" .
id:candidate-synthetic-2 a onto:AddressCandidate ; onto:candidateText "EXAMPLE AVENUE" .

# Inferred: not asserted as InferredResolution; the reasoner must classify it from the alternate address.
id:resolution-synthetic-inferred a onto:AddressResolution ;
    rdfs:comment "Synthetic placeholder: the lot was reached through an alternate address."@en ;
    onto:hasInputAddress id:address-synthetic-corner ;
    onto:usedAlternateAddress id:address-synthetic-alternate ;
    onto:hasOutcome vocab:matched-by-variant ;
    onto:resolvedToTaxLot id:taxlot-synthetic .
id:address-synthetic-corner a onto:StreetAddress ; onto:addressText "2 Example St (corner)" .
id:address-synthetic-alternate a onto:StreetAddress ; onto:addressText "2 Example Ave" .
id:taxlot-synthetic a onto:TaxLot ; onto:hasBbl "3000000000" .
