@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix onto: <https://watchline.example/onto/> .
@prefix id:   <https://watchline.example/id/> .

# Q1 example data. Values come from the verified fixtures in tests/q1_*/fixtures.yaml
# (frozen snapshot: PLUTO 26v1, HPD registrations 2026-05-29). Values a fixture does not hold are omitted.

# Anchor D: three buildings on one lot, lot-wide units.
id:lot-3008210012 a onto:TaxLot ;
    onto:bbl "3008210012" ; onto:address "224 54 STREET" ; onto:hpdRegistered true ;
    onto:plutoBuildingCount 3 ; onto:yearBuilt 1911 ; onto:buildingClass "C1" ;
    onto:residentialUnits 18 ; onto:assessedTotalValue 814500 ;
    onto:hasBuilding id:building-3324448, id:building-3324450, id:building-3324451 .
id:building-3324448 a onto:Building ; onto:bin "3324448" ; onto:address "218 54TH STREET" .
id:building-3324450 a onto:Building ; onto:bin "3324450" ; onto:address "220 54TH STREET" .
id:building-3324451 a onto:Building ; onto:bin "3324451" ; onto:address "224 54TH STREET" .

# Anchor A: one building; HPD spells the street differently from PLUTO.
id:lot-3008260002 a onto:TaxLot ;
    onto:bbl "3008260002" ; onto:address "5413 7 AVENUE" ; onto:hpdRegistered true ;
    onto:plutoBuildingCount 1 ; onto:yearBuilt 1911 ; onto:buildingClass "C1" ;
    onto:residentialUnits 32 ; onto:assessedTotalValue 868950 ;
    onto:hasBuilding id:building-3014788 .
id:building-3014788 a onto:Building ; onto:bin "3014788" ; onto:address "5413 SEVENTH AVENUE" .

# Anchor F: not registered, so no building is recorded.
id:lot-3008970014 a onto:TaxLot ;
    onto:bbl "3008970014" ; onto:address "259 22 STREET" ; onto:hpdRegistered false ;
    onto:plutoBuildingCount 1 ; onto:yearBuilt 2025 ; onto:buildingClass "D7" ;
    onto:residentialUnits 40 ; onto:assessedTotalValue 1451700 .

# 17 Battery Place: PLUTO counts 2 buildings, HPD lists 1.
id:lot-1000157501 a onto:TaxLot ;
    onto:bbl "1000157501" ; onto:address "17 BATTERY PLACE" ; onto:hpdRegistered true ;
    onto:plutoBuildingCount 2 ; onto:yearBuilt 1902 ; onto:buildingClass "RM" ; onto:residentialUnits 500 ;
    onto:hasBuilding id:building-1082634 .
id:building-1082634 a onto:Building ; onto:bin "1082634" ; onto:address "1 WEST STREET" .

# BIN 1003074 sits on two lots (hasBuilding is many to many). The second lot is not in PLUTO.
id:lot-1002367504 a onto:TaxLot ;
    onto:bbl "1002367504" ; onto:hpdRegistered true ; onto:plutoBuildingCount 1 ;
    onto:hasBuilding id:building-1003074 .
id:lot-1002360018 a onto:TaxLot ;
    onto:bbl "1002360018" ; onto:hpdRegistered true ;
    onto:hasBuilding id:building-1003074 .
id:building-1003074 a onto:Building ; onto:bin "1003074" ; onto:address "185 GRAND STREET" .
