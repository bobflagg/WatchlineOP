    onto:documentDate "2015-03-20"^^xsd:date ; onto:recordedDate "2015-04-08"^^xsd:date ; onto:documentAmount 1546326 ;
    onto:hasParty id:fin-2015032301122001-p1, id:fin-2015032301122001-p2 .
id:fin-2015032301122001-p1 a onto:DocumentParty ; onto:partyRole 1 .
