@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix onto:  <https://watchline.example/onto/> .

# Watchline ontology (TBox). Graph-stored terms only; see ontology/ontology-notes.md.
# Namespaces: concepts https://watchline.example/vocab/, elements https://watchline.example/onto/,
# instances https://watchline.example/id/. Every element traces to concepts in ontology/concept-mapping.csv.

<https://watchline.example/onto/watchline> a owl:Ontology ;
    dct:title "Watchline ontology"@en ;
    dct:description "Classes and properties for the WatchlineOP landlord research graph. Q1 covers tax lots, buildings and their source-reported characteristics. Q2 adds HPD registrations and their owner contacts. Q3 adds deeds, their grantees and the mailing addresses of grantees and owner contacts."@en .

onto:question a owl:AnnotationProperty ;
    rdfs:label "question"@en ;
    rdfs:comment "Competency question or sub-question ID (for example Q1.2) that the element serves."@en .

# --- Classes ---

onto:TaxLot a owl:Class ;
    rdfs:label "tax lot"@en ;
    rdfs:comment "A parcel of land identified by its BBL, in the rental-market scope of the graph. Carries the lot-wide PLUTO values."@en ;
    onto:question "Q1.1", "Q1.2", "Q1.4" ;
    owl:disjointWith onto:Building .

onto:Building a owl:Class ;
    rdfs:label "building"@en ;
    rdfs:comment "A structure identified by its BIN, as named in HPD registrations. Never carries a lot-wide value."@en ;
    onto:question "Q1.2" .

# --- Object property ---

onto:hasBuilding a owl:ObjectProperty ;
    rdfs:label "has building"@en ;
    rdfs:comment "Links a tax lot to a building registered on it. Many to many: a lot can have several buildings and a BIN can appear on more than one lot."@en ;
    onto:question "Q1.2" ;
    rdfs:domain onto:TaxLot ;
    rdfs:range onto:Building .

# --- Datatype properties on TaxLot ---

onto:bbl a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "BBL"@en ;
    rdfs:comment "The 10-character borough-block-lot identifier of a tax lot."@en ;
    onto:question "Q1.1" ;
    rdfs:domain onto:TaxLot ;
    rdfs:range xsd:string .

onto:hpdRegistered a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "HPD registered"@en ;
    rdfs:comment "True when HPD has at least one multiple-dwelling registration for the tax lot."@en ;
    onto:question "Q1.1" ;
    rdfs:domain onto:TaxLot ;
    rdfs:range xsd:boolean .

onto:plutoBuildingCount a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "PLUTO building count"@en ;
    rdfs:comment "The number of buildings PLUTO records on the tax lot. It is not the number of buildings HPD lists."@en ;
    onto:question "Q1.2" ;
    rdfs:domain onto:TaxLot ;
    rdfs:range xsd:integer .

onto:yearBuilt a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "year built"@en ;
    rdfs:comment "PLUTO's year built for the tax lot. Absent when PLUTO has none."@en ;
    onto:question "Q1.4" ;
    rdfs:domain onto:TaxLot ;
    rdfs:range xsd:integer .

onto:buildingClass a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "building class"@en ;
    rdfs:comment "PLUTO's building class code for the tax lot. Absent when blank."@en ;
    onto:question "Q1.4" ;
    rdfs:domain onto:TaxLot ;
    rdfs:range xsd:string .

onto:residentialUnits a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "residential units"@en ;
    rdfs:comment "PLUTO's count of residential units for the whole tax lot. Lot-wide: never attached to a building. 0 means PLUTO records none."@en ;
    onto:question "Q1.4" ;
    rdfs:domain onto:TaxLot ;
    rdfs:range xsd:integer .

onto:assessedTotalValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "assessed total value"@en ;
    rdfs:comment "PLUTO's total assessed value of the tax lot, in whole US dollars. 0 means PLUTO records none."@en ;
    onto:question "Q1.4" ;
    rdfs:domain onto:TaxLot ;
    rdfs:range xsd:integer .

# --- Datatype property on Building ---

onto:bin a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "BIN"@en ;
    rdfs:comment "The 7-character Building Identification Number of a building."@en ;
    onto:question "Q1.2" ;
    rdfs:domain onto:Building ;
    rdfs:range xsd:string .

# --- Datatype property used on both classes ---

onto:address a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "address"@en ;
    rdfs:comment "A street address of a tax lot or of a building. Its domain is the union of both classes. Absent when tied source records name different addresses."@en ;
    onto:question "Q1.1", "Q1.2" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( onto:TaxLot onto:Building ) ] ;
    rdfs:range xsd:string .

# --- Q2 classes ---

onto:Registration a owl:Class ;
    rdfs:label "HPD registration"@en ;
    rdfs:comment "A multiple-dwelling registration filed with HPD, identified by its registration id. One registration can cover several buildings, and a building can have several registrations. An HPD registrant is who registered, not proof of title."@en ;
    onto:question "Q2.1", "Q2.2" ;
    owl:disjointWith onto:Building, onto:OwnerContact .

onto:OwnerContact a owl:Class ;
    rdfs:label "registered owner contact"@en ;
    rdfs:comment "A contact of an owner type (corporate, individual or joint owner) recorded on one HPD registration, with the name as HPD records it. Not the deed grantee, a process contact or the managing agent."@en ;
    onto:question "Q2.2" .

# --- Q2 object properties ---

onto:hasRegistration a owl:ObjectProperty ;
    rdfs:label "has registration"@en ;
    rdfs:comment "Links a building to an HPD registration that lists it. Many to many. The last registered date and registration end date belong to the building and registration pair; the graph stores them on the relationship."@en ;
    onto:question "Q2.1" ;
    rdfs:domain onto:Building ;
    rdfs:range onto:Registration .

onto:hasOwnerContact a owl:ObjectProperty ;
    rdfs:label "has owner contact"@en ;
    rdfs:comment "Links an HPD registration to an owner contact recorded on it. Contacts belong to the registration, not to one building."@en ;
    onto:question "Q2.2" ;
    rdfs:domain onto:Registration ;
    rdfs:range onto:OwnerContact .

# --- Q2 datatype properties ---

onto:registrationId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "registration id"@en ;
    rdfs:comment "HPD's identifier for a registration. It repeats across the buildings the registration covers."@en ;
    onto:question "Q2.1" ;
    rdfs:domain onto:Registration ;
    rdfs:range xsd:integer .

onto:lastRegistered a owl:DatatypeProperty ;
    rdfs:label "last registered date"@en ;
    rdfs:comment "The date a registration was last filed, as HPD records it for a building. In the graph it is a property of the has-registration relationship; the ontology puts it on the registration. Absent when HPD has no date or its rows disagree."@en ;
    onto:question "Q2.1" ;
    rdfs:domain onto:Registration ;
    rdfs:range xsd:date .

onto:registrationEnd a owl:DatatypeProperty ;
    rdfs:label "registration end date"@en ;
    rdfs:comment "The date a registration period ends, as HPD records it for a building. In the graph it is a property of the has-registration relationship; the ontology puts it on the registration. The source has no period start. Absent when its rows disagree."@en ;
    onto:question "Q2.1" ;
    rdfs:domain onto:Registration ;
    rdfs:range xsd:date .

onto:contactType a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "contact type"@en ;
    rdfs:comment "The type HPD gives an owner contact: CorporateOwner, IndividualOwner or JointOwner. Stored as HPD spells it."@en ;
    onto:question "Q2.2" ;
    rdfs:domain onto:OwnerContact ;
    rdfs:range xsd:string .

onto:ownerName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "owner name"@en ;
    rdfs:comment "The name of an owner contact exactly as HPD records it: the corporation name, or first name, middle initial and last name joined. Absent when the source name is blank."@en ;
    onto:question "Q2.2" ;
    rdfs:domain onto:OwnerContact ;
    rdfs:range xsd:string .

# --- Q3 classes ---

onto:Deed a owl:Class ;
    rdfs:label "deed"@en ;
    rdfs:comment "A recorded ACRIS document of one of eight deed types (DEED, DEED TS, DEED LE, DEED RC, DEEDO, DEEDP, CORRD, CONDEED), identified by its document id. It can name many tax lots. It records a transfer of title, not that a sale took place."@en ;
    onto:question "Q3.1", "Q3.2" ;
    owl:disjointWith onto:Registration .

onto:Grantee a owl:Class ;
    rdfs:label "grantee"@en ;
    rdfs:comment "A party named on one deed as receiving title, with the name and address as that deed records them. Not an HPD owner contact; the two are compared at answer time, never merged."@en ;
    onto:question "Q3.2" ;
    owl:disjointWith onto:OwnerContact .

# --- Q3 object properties ---

onto:hasDeed a owl:ObjectProperty ;
    rdfs:label "has deed"@en ;
    rdfs:comment "Links a tax lot to a deed recorded against it. Many to many: a deed can name several lots."@en ;
    onto:question "Q3.1" ;
    rdfs:domain onto:TaxLot ;
    rdfs:range onto:Deed .

onto:hasGrantee a owl:ObjectProperty ;
    rdfs:label "has grantee"@en ;
    rdfs:comment "Links a deed to a grantee named on it. A deed can have several grantees, or none."@en ;
    onto:question "Q3.2" ;
    rdfs:domain onto:Deed ;
    rdfs:range onto:Grantee .

# --- Q3 datatype properties on Deed ---

onto:documentId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "document id"@en ;
    rdfs:comment "ACRIS's identifier for a recorded document."@en ;
    onto:question "Q3.1" ;
    rdfs:domain onto:Deed ;
    rdfs:range xsd:string .

onto:documentType a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "document type"@en ;
    rdfs:comment "The ACRIS code for the kind of deed, as recorded from the current version of the document."@en ;
    onto:question "Q3.1" ;
    rdfs:domain onto:Deed ;
    rdfs:range xsd:string .

onto:documentDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "document date"@en ;
    rdfs:comment "The date written on the deed, as ACRIS records it. Absent when ACRIS has none. Not used to find the most recent deed."@en ;
    onto:question "Q3.1" ;
    rdfs:domain onto:Deed ;
    rdfs:range xsd:date .

onto:recordedDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "recorded date"@en ;
    rdfs:comment "The date the deed was recorded with the city register. The rule for the most recent deed."@en ;
    onto:question "Q3.1" ;
    rdfs:domain onto:Deed ;
    rdfs:range xsd:date .

onto:documentAmount a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "document amount"@en ;
    rdfs:comment "The dollar amount ACRIS records on the deed, in whole US dollars. 0 is common and is never read as a free sale."@en ;
    onto:question "Q3.1" ;
    rdfs:domain onto:Deed ;
    rdfs:range xsd:integer .

# --- Q3 datatype property on Grantee ---

onto:granteeName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "grantee name"@en ;
    rdfs:comment "The name of a grantee exactly as the deed records it (trimmed). Never normalized in the graph. Absent when the party row has no name."@en ;
    onto:question "Q3.2" ;
    rdfs:domain onto:Grantee ;
    rdfs:range xsd:string .

# --- Q3 datatype properties used on both Grantee and OwnerContact ---

onto:mailingAddress a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "mailing address"@en ;
    rdfs:comment "The street line of the address a party gives: for a grantee the first address line on the deed, for an owner contact the business house number and street name. Can hold a care-of line. Absent when blank, or for an owner contact when exact duplicate rows disagree."@en ;
    onto:question "Q3.2", "Q3.5" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( onto:Grantee onto:OwnerContact ) ] ;
    rdfs:range xsd:string .

onto:addressLineTwo a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "address line two"@en ;
    rdfs:comment "The second address line a party gives (a unit, suite, floor or another street line), as recorded. Reported apart and never compared. Absent when blank."@en ;
    onto:question "Q3.2", "Q3.5" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( onto:Grantee onto:OwnerContact ) ] ;
    rdfs:range xsd:string .

onto:zipCode a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "ZIP code"@en ;
    rdfs:comment "The ZIP code of the mailing address a party gives, as recorded (five digits, nine digits or non-US text). Absent when blank."@en ;
    onto:question "Q3.2", "Q3.5" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( onto:Grantee onto:OwnerContact ) ] ;
    rdfs:range xsd:string .
