@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix vocab: <https://watchline.example/vocab/> .

vocab:watchline a skos:ConceptScheme ;
    skos:prefLabel "Watchline vocabulary"@en ;
    dct:title "Watchline vocabulary"@en ;
    dct:created "2026-11-11"^^xsd:date ;
    dct:description "Controlled vocabulary for the WatchlineOP landlord research ontology pipeline."@en ;
    skos:hasTopConcept vocab:tax-lot, vocab:bbl, vocab:building, vocab:bin, vocab:street-address,
        vocab:address-resolution, vocab:address-resolution-outcome, vocab:address-candidate,
        vocab:street-name-variant, vocab:hpd-registration,
        vocab:inferred-resolution, vocab:geosupport-return-code,
        vocab:geosupport-reason-code, vocab:source-reported-characteristic,
        vocab:reported-count, vocab:source-snapshot, vocab:source-record .

vocab:address-resolution-outcomes a skos:ConceptScheme ;
    skos:prefLabel "Address resolution outcomes"@en ;
    dct:title "Address resolution outcomes"@en ;
    dct:created "2026-11-11"^^xsd:date ;
    dct:description "Controlled values for the outcome of resolving an input address."@en ;
    skos:hasTopConcept vocab:matched-exactly, vocab:matched-by-variant,
        vocab:ambiguous, vocab:not-found .

# --- Places and identifiers (Q1.1, Q1.2) ---

vocab:tax-lot a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "tax lot"@en ;
    skos:altLabel "parcel"@en, "lot"@en ;
    skos:definition "A parcel of land recorded as one unit for NYC property tax purposes."@en ;
    skos:scopeNote "A tax lot is not necessarily one building. Lot counts and building counts differ."@en ;
    dct:source "specs/questions/q01.md" .

# Top concept by intent: an identifier is not a kind of tax lot (is-a test fails).
vocab:bbl a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "BBL"@en ;
    skos:altLabel "borough-block-lot"@en ;
    skos:definition "The NYC identifier of a tax lot: borough, block and lot number."@en ;
    skos:scopeNote "Identifies a tax lot; it is not the tax lot itself."@en ;
    skos:related vocab:tax-lot ;
    dct:source "specs/questions/q01.md" .

vocab:building a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "building"@en ;
    skos:altLabel "structure"@en ;
    skos:definition "A structure recorded by the city under its own building identifier."@en ;
    skos:scopeNote "In Q1, buildings are known only through HPD registrations. A lot with no registration has no recorded building, which is not the same as having none."@en ;
    dct:source "specs/questions/q01.md" .

# Top concept by intent: an identifier is not a kind of building (is-a test fails).
vocab:bin a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "BIN"@en ;
    skos:altLabel "building identification number"@en ;
    skos:definition "The NYC identifier of a building."@en ;
    skos:scopeNote "Identifies a building; it is not the building itself."@en ;
    skos:related vocab:building ;
    dct:source "specs/questions/q01.md" .

vocab:addressed-building a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:prefLabel "addressed building"@en ;
    skos:definition "The building at the input street address, as distinguished from the other buildings on the same tax lot."@en ;
    skos:scopeNote "A role a building plays in one answer, not a kind of building."@en ;
    skos:broader vocab:building ;
    dct:source "specs/questions/q01.md" .

vocab:street-address a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "street address"@en ;
    skos:altLabel "address"@en, "input address"@en ;
    skos:definition "A house number and street name, in a borough, that names a place."@en ;
    skos:scopeNote "Sources spell street names differently (7 AVENUE, SEVENTH AVENUE). An input address is a street address in the role of question input."@en ;
    dct:source "specs/questions/q01.md" .

vocab:alternate-address a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:prefLabel "alternate address"@en ;
    skos:definition "A different street address, such as a street-name variant or corner address, under which the same tax lot is recorded."@en ;
    skos:scopeNote "Used only when the input address is absent from the lot data. The resolution is then inferred."@en ;
    skos:broader vocab:street-address ;
    dct:source "specs/questions/q01.md", "specs/questions/q01.md#scenarios" .

# --- Address resolution (Q1.3) ---

vocab:address-resolution a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "address resolution"@en ;
    skos:definition "The act of mapping an input street address to a tax lot."@en ;
    skos:scopeNote "Its result is an address resolution outcome. The service evidence is the Geosupport return code and reason code."@en ;
    skos:related vocab:address-resolution-outcome ;
    dct:source "specs/questions/q01.md", "specs/questions/q01.md#address-resolution-outcomes" .

vocab:street-name-variant a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "street-name variant"@en ;
    skos:definition "An alternative spelling or form of the same street name, such as 7 AVENUE and SEVENTH AVENUE, or 54 STREET and 54TH STREET."@en ;
    skos:scopeNote "Not the outcome matched by variant, which is the classification of a whole resolution."@en ;
    skos:related vocab:matched-by-variant ;
    dct:source "specs/questions/q01.md" .

vocab:hpd-registration a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "HPD registration"@en ;
    skos:definition "A multiple-dwelling registration filed with the city's housing agency (HPD), associating a street address with a tax lot and a building."@en ;
    skos:scopeNote "In Q1 it is the only source of BINs, so a lot with no registration has no recorded building. Q2 extends this concept with the parties a registration discloses."@en ;
    skos:related vocab:bin ;
    dct:source "specs/questions/q01.md", "data/sources.yaml" .

vocab:address-resolution-outcome a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "address resolution outcome"@en ;
    skos:altLabel "match outcome"@en ;
    skos:definition "The classification of an input address's resolution, taking one value from the address resolution outcomes scheme."@en ;
    skos:scopeNote "Decided by the Geosupport return code and a comparison of the returned address with the input, never by message text."@en ;
    dct:source "specs/questions/q01.md", "specs/questions/q01.md#address-resolution-outcomes" .

vocab:matched-exactly a skos:Concept ;
    skos:inScheme vocab:address-resolution-outcomes ;
    skos:topConceptOf vocab:address-resolution-outcomes ;
    skos:prefLabel "matched exactly"@en ;
    skos:definition "The address resolved to a tax lot and the returned house number and street equal the input after case and whitespace normalization only."@en ;
    dct:source "specs/questions/q01.md", "specs/questions/q01.md#address-resolution-outcomes" .

vocab:matched-by-variant a skos:Concept ;
    skos:inScheme vocab:address-resolution-outcomes ;
    skos:topConceptOf vocab:address-resolution-outcomes ;
    skos:prefLabel "matched by variant"@en ;
    skos:definition "The address resolved to a tax lot, but the returned address differs from the input beyond case and whitespace, or the service returned a warning."@en ;
    skos:scopeNote "Not the same as a street-name spelling variant. The answer reports the returned address and reason code."@en ;
    dct:source "specs/questions/q01.md", "specs/questions/q01.md#address-resolution-outcomes" .

vocab:ambiguous a skos:Concept ;
    skos:inScheme vocab:address-resolution-outcomes ;
    skos:topConceptOf vocab:address-resolution-outcomes ;
    skos:prefLabel "ambiguous"@en ;
    skos:definition "The address matched several similar street names and no tax lot was chosen."@en ;
    skos:scopeNote "The answer returns the address candidates and never silently selects one."@en ;
    dct:source "specs/questions/q01.md", "specs/questions/q01.md#address-resolution-outcomes" .

vocab:not-found a skos:Concept ;
    skos:inScheme vocab:address-resolution-outcomes ;
    skos:topConceptOf vocab:address-resolution-outcomes ;
    skos:prefLabel "not found"@en ;
    skos:altLabel "no match"@en ;
    skos:definition "No tax lot was returned for the address."@en ;
    skos:scopeNote "The answer reports the codes and variants tried and does not guess a nearby lot."@en ;
    dct:source "specs/questions/q01.md", "specs/questions/q01.md#address-resolution-outcomes" .

vocab:address-candidate a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "address candidate"@en ;
    skos:definition "One of several street names or addresses returned for an ambiguous input address."@en ;
    skos:scopeNote "A candidate is not a match. A match is the single result of an unambiguous resolution."@en ;
    dct:source "specs/questions/q01.md", "specs/questions/q01.md#address-resolution-outcomes" .

vocab:inferred-resolution a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "inferred resolution"@en ;
    skos:definition "A resolution reached through an alternate address because the input address was absent from the lot data."@en ;
    skos:scopeNote "A derived conclusion, to be labelled as inferred in the answer."@en ;
    dct:source "specs/questions/q01.md", "specs/questions/q01.md#scenarios" .

vocab:geosupport-return-code a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "Geosupport return code"@en ;
    skos:altLabel "GRC"@en ;
    skos:definition "The code with which the Geosupport address service reports the result of a request."@en ;
    skos:scopeNote "Separate from the reason code. Classification is based on codes, not message text."@en ;
    dct:source "specs/questions/q01.md", "specs/questions/q01.md#address-resolution-outcomes" .

vocab:geosupport-reason-code a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "Geosupport reason code"@en ;
    skos:definition "The code with which the Geosupport address service qualifies a return code."@en ;
    skos:scopeNote "Separate from the return code."@en ;
    dct:source "specs/questions/q01.md", "specs/questions/q01.md#address-resolution-outcomes" .

# --- Characteristics and counts (Q1.4) ---

vocab:source-reported-characteristic a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "source-reported characteristic"@en ;
    skos:definition "A property of a tax lot or building as stated by a source record."@en ;
    skos:scopeNote "A recorded assertion. It says what the source states, not that the value is correct."@en ;
    dct:source "specs/questions/q01.md" .

vocab:year-built a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:prefLabel "year built"@en ;
    skos:altLabel "construction year"@en ;
    skos:definition "The year of construction as reported by the source."@en ;
    skos:broader vocab:source-reported-characteristic ;
    dct:source "specs/questions/q01.md", "data/sources.yaml" .

vocab:building-class a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:prefLabel "building class"@en ;
    skos:definition "The city's code classifying the primary use and type of the buildings on a tax lot."@en ;
    skos:broader vocab:source-reported-characteristic ;
    dct:source "specs/questions/q01.md", "data/sources.yaml" .

vocab:residential-units a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:prefLabel "residential units"@en ;
    skos:altLabel "dwelling units"@en, "apartments"@en ;
    skos:definition "The number of residential units on a tax lot as reported by the source."@en ;
    skos:scopeNote "Lot-wide. Must not be copied to each building or summed across a lot's buildings."@en ;
    skos:broader vocab:source-reported-characteristic ;
    dct:source "specs/questions/q01.md", "data/sources.yaml" .

vocab:assessed-value a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:prefLabel "assessed value"@en ;
    skos:altLabel "assessed total value"@en ;
    skos:definition "The total value the city assigns to a tax lot for property tax, in dollars."@en ;
    skos:broader vocab:source-reported-characteristic ;
    dct:source "specs/questions/q01.md", "data/sources.yaml" .

vocab:reported-count a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "reported count"@en ;
    skos:definition "A tally given in an answer, always with its counting unit named."@en ;
    skos:scopeNote "Parcel, building and unit counts are reported separately and never converted into one another."@en ;
    dct:source "specs/questions/q01.md" .

vocab:parcel-count a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:prefLabel "parcel count"@en ;
    skos:definition "A reported count whose counting unit is the tax lot."@en ;
    skos:broader vocab:reported-count ;
    dct:source "specs/questions/q01.md" .

vocab:building-count a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:prefLabel "building count"@en ;
    skos:definition "A reported count whose counting unit is the building."@en ;
    skos:scopeNote "Complete only for registered buildings."@en ;
    skos:broader vocab:reported-count ;
    dct:source "specs/questions/q01.md", "data/sources.yaml" .

vocab:unit-count a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:prefLabel "unit count"@en ;
    skos:definition "A reported count whose counting unit is the residential unit."@en ;
    skos:scopeNote "The tally given in an answer. The source characteristic it draws on is residential units."@en ;
    skos:broader vocab:reported-count ;
    skos:related vocab:residential-units ;
    dct:source "specs/questions/q01.md" .

# --- Provenance ---

vocab:source-snapshot a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "source snapshot"@en ;
    skos:definition "A specific, identified version of a source dataset from which values were taken."@en ;
    dct:source "specs/questions/q01.md", "data/README.md" .

vocab:source-record a skos:Concept ;
    skos:inScheme vocab:watchline ;
    skos:topConceptOf vocab:watchline ;
    skos:prefLabel "source record"@en ;
    skos:definition "A single row or entry in a source snapshot from which a value was taken."@en ;
    dct:source "specs/questions/q01.md", "specs/physical-implementation.md" .
