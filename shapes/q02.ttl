@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix onto: <https://watchline.example/onto/> .
@prefix s2c:  <https://w3id.org/shacl2cypher#> .
@prefix shp:  <https://watchline.example/shapes/> .

# Q2 shapes: the rules OWL cannot express (ontology/ontology-notes.md, Q2 "Rules for Stage 6 shapes").
# Compiled together with shapes/q01.ttl, which names Building, bin and hasBuilding.
# Rules the compiler cannot express (relationship properties) are named Cypher checks in queries/checks/.

# --- Graph names ---
onto:Registration s2c:label "Registration" .
onto:OwnerContact s2c:label "OwnerContact" .
onto:hasRegistration s2c:relationship "HAS_REGISTRATION" ; s2c:direction "out" .
onto:hasOwnerContact s2c:relationship "HAS_OWNER_CONTACT" ; s2c:direction "out" .
onto:registrationId s2c:property "registrationId" .
onto:contactType s2c:property "contactType" .
onto:ownerName s2c:property "name" .

# --- Rules ---
shp:RegistrationShape a sh:NodeShape ;
    s2c:key "registrationId" ;
    sh:targetClass onto:Registration ;
    # R1 id present, a positive integer
    sh:property [ sh:path onto:registrationId ; sh:minCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    # R3 every registration is linked to at least one building
    sh:property [ sh:path [ sh:inversePath onto:hasRegistration ] ; sh:minCount 1 ] ;
    sh:property [ sh:path onto:hasOwnerContact ; sh:class onto:OwnerContact ] .

shp:OwnerContactShape a sh:NodeShape ;
    s2c:key "contactKey" ;
    sh:targetClass onto:OwnerContact ;
    # R2 type present and one of the three owner types
    sh:property [ sh:path onto:contactType ; sh:minCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^(CorporateOwner|IndividualOwner|JointOwner)$" ] ;
    # R5 a blank name is absent, never an empty string
    sh:property [ sh:path onto:ownerName ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    # R3 every owner contact is linked to exactly one registration
    sh:property [ sh:path [ sh:inversePath onto:hasOwnerContact ] ; sh:minCount 1 ; sh:maxCount 1 ] .

shp:BuildingRegistrationShape a sh:NodeShape ;
    s2c:key "bin" ;
    sh:targetClass onto:Building ;
    sh:property [ sh:path onto:hasRegistration ; sh:class onto:Registration ] .
