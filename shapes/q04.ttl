@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix onto: <https://watchline.example/onto/> .
@prefix s2c:  <https://w3id.org/shacl2cypher#> .
@prefix shp:  <https://watchline.example/shapes/> .

# Q4 shapes: the rules OWL cannot express (ontology/ontology-notes.md, Q4 "Rules for Stage 6 shapes").
# Compiled together with shapes/q02.ttl (Contact, names, type) and shapes/q03.ttl (address properties).
# Conditional rules (corporation name only on corporate owners, agents and lessees; site managers have no address) are named Cypher checks.

# --- Graph names ---
onto:contactTitle s2c:property "title" .

# --- Rules ---
shp:ContactTitleShape a sh:NodeShape ;
    s2c:key "contactKey" ;
    sh:targetClass onto:Contact ;
    # R3 a blank title is absent, never an empty string
    sh:property [ sh:path onto:contactTitle ; sh:datatype xsd:string ; sh:minLength 1 ] .
